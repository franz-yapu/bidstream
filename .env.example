# Entorno local de desarrollo. Copia a .env si necesitas cambiar algo (no se versiona).
KAFKA_PORT=9092
POSTGRES_PORT=5432
POSTGRES_USER=bidstream
POSTGRES_PASSWORD=bidstream
POSTGRES_DB=bidstream
KAFKA_BROKERS=localhost:9092
DATABASE_URL=postgresql://bidstream:bidstream@localhost:5432/bidstream

# Kafka: local (por defecto) o Azure Event Hubs, sin cambiar código.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=bidstream
# Event Hubs: KAFKA_BROKERS=<ns>.servicebus.windows.net:9093, KAFKA_SECURITY_PROTOCOL=SASL_SSL,
# KAFKA_SASL_USERNAME=$ConnectionString y KAFKA_SASL_PASSWORD=<cadena de conexión> (secreto).

# API REST
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
