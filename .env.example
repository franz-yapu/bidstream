# Entorno local de desarrollo. Copia a .env si necesitas cambiar algo (no se versiona).
KAFKA_PORT=9092
POSTGRES_PORT=5432
POSTGRES_USER=bidstream
POSTGRES_PASSWORD=bidstream
POSTGRES_DB=bidstream
KAFKA_BROKERS=localhost:9092
DATABASE_URL=postgresql://bidstream:bidstream@localhost:5432/bidstream
# La administración del DLQ (/v1/admin/dlq) la hace el rol ADMIN con su token de acceso (F1).

# Kafka: local (por defecto) o Azure Event Hubs, sin cambiar código.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=bidstream
# Event Hubs: KAFKA_BROKERS=<ns>.servicebus.windows.net:9093, KAFKA_SECURITY_PROTOCOL=SASL_SSL,
# KAFKA_SASL_USERNAME=$ConnectionString y KAFKA_SASL_PASSWORD=<cadena de conexión> (secreto).

# API REST
# Tenant por cabecera X-Tenant-Id: solo fuera de producción (hasta F1). Con NODE_ENV=production la API no arranca.
TENANT_MODE=header
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Relay del outbox
RELAY_BATCH_SIZE=100
RELAY_POLL_MS=200
RELAY_STANDBY_POLL_MS=5000

# API de lectura GraphQL (puerto propio para no chocar con la API REST)
GRAPHQL_PORT=4000
GQL_MAX_PAGE_SIZE=100
GQL_MAX_DEPTH=7
GQL_MAX_COMPLEXITY=1000
GQL_MAX_ALIASES=15
GQL_MAX_TOKENS=2000
GQL_MAX_BODY_BYTES=102400
# GQL_INTROSPECTION=false   (por defecto activa fuera de producción)
GQL_MAX_SUBSCRIPTIONS_PER_TENANT=500
GQL_SUBSCRIPTION_QUEUE=50

# Firma de eventos (F3): fuera de producción está apagada. `node scripts/generate-keys.mjs` crea un par de
# desarrollo en .env.signing.private (solo el relay) y .env.signing.public (el resto); no se versionan.
# EVENT_SIGNATURE_MODE=off            # enforce (por defecto en producción) | off
# EVENT_SIGNING_KEY_ID=dev-1          # relay
# EVENT_SIGNING_PRIVATE_KEY=          # relay: Ed25519 PKCS#8 en PEM o en base64
# EVENT_VERIFICATION_KEYS='{"dev-1":"<PEM público o base64>"}'   # consumidores
# EVENT_SIGNING_REQUIRED_FROM=2026-11-13T00:00:00.000Z           # lo anterior sin firma se acepta

# Autenticación (F1). En producción AUTH_MODE=jwt y las claves son obligatorias; fuera de ella, `header`
# (X-Tenant-Id / X-Bidder-Id) es el modo por defecto. Par Ed25519: `node scripts/generate-keys.mjs --kid dev-1`
# sirve de ejemplo; en producción las claves salen de Key Vault.
# AUTH_MODE=jwt
# AUTH_JWT_KEY_ID=dev-1
# AUTH_JWT_PRIVATE_KEY=               # API: Ed25519 PKCS#8 en PEM o en base64 (emite tokens)
# AUTH_JWT_PUBLIC_KEYS='{"dev-1":"<PEM público o base64>"}'   # quien solo verifica (GraphQL) y la rotación
# AUTH_ACCESS_TTL_SECONDS=600  AUTH_REFRESH_TTL_SECONDS=604800
# AUTH_MAX_FAILED_ATTEMPTS=5   AUTH_LOCK_MINUTES=15   AUTH_RATE_LIMIT_PER_MINUTE=20
# BOOTSTRAP_ADMIN_TENANT_ID=  BOOTSTRAP_ADMIN_EMAIL=  BOOTSTRAP_ADMIN_PASSWORD=   # primer ADMIN, los tres juntos

# Endurecimiento (F2): pujas por postor y minuto, límite global por IP (por réplica) y CORS.
# CORS_ALLOWED_ORIGINS vacío = ninguno; solo orígenes exactos (https://app.ejemplo.com), nunca `*`.
# BID_RATE_LIMIT_PER_MINUTE=30  API_RATE_LIMIT_PER_MINUTE=600
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com
