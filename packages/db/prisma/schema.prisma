// Esquema de la proyección y del outbox (spec §6) con las correcciones de docs/sdd/B1/SDD.md §2.4.
// Los índices parciales no se pueden expresar aquí: viven como SQL en la migración inicial.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuctionStatus {
  OPEN
  CLOSED

  @@map("auction_status")
}

enum LotStatus {
  OPEN
  CLOSED

  @@map("lot_status")
}

model Auction {
  id       String        @id @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  title    String
  opensAt  DateTime      @map("opens_at") @db.Timestamptz(3)
  closesAt DateTime      @map("closes_at") @db.Timestamptz(3)
  status   AuctionStatus

  @@index([tenantId, status])
  @@map("auction")
}

model Lot {
  id            String    @id @db.Uuid
  /// Sin clave foránea: los eventos de subasta y de lote viajan por particiones distintas y, en un
  /// reproceso, el lote puede procesarse antes que su subasta (docs/sdd/D4/SDD.md §2.4).
  auctionId     String    @map("auction_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  title         String
  startingPrice Decimal   @map("starting_price") @db.Decimal(12, 2)
  minIncrement  Decimal   @map("min_increment") @db.Decimal(12, 2)
  currency      String    @db.Char(3)
  closesAt      DateTime  @map("closes_at") @db.Timestamptz(3)
  currentPrice  Decimal?  @map("current_price") @db.Decimal(12, 2)
  currentBidder String?   @map("current_bidder") @db.Uuid
  status        LotStatus
  winnerId      String?   @map("winner_id") @db.Uuid
  bids          Bid[]

  @@index([tenantId, status, closesAt])
  @@map("lot")
}

/// `id` es el `eventId` del `BidPlaced` que la originó: reprocesar el mismo evento no duplica la puja.
model Bid {
  id       String   @id @db.Uuid
  lotId    String   @map("lot_id") @db.Uuid
  bidderId String   @map("bidder_id") @db.Uuid
  amount   Decimal  @db.Decimal(12, 2)
  placedAt DateTime @map("placed_at") @db.Timestamptz(3)
  /// Marca la puja ganadora al cerrar el lote. Un índice único parcial garantiza como mucho una por lote.
  awarded  Boolean  @default(false)
  lot      Lot      @relation(fields: [lotId], references: [id])

  // desempate determinista: mayor monto, luego el más antiguo, luego id
  @@index([lotId, amount(sort: Desc), placedAt, id], map: "bid_ranking_idx")
  @@map("bid")
}

/// Modelo de escritura del decisor de pujas (C3, ADR-0011): el estado **autoritativo** de cada lote,
/// que el decisor actualiza en la misma transacción que sus decisiones. Distinto de `lot` (la
/// proyección, eventualmente consistente). Se puede reconstruir desde el log con `evolveLot`.
model LotDecision {
  lotId         String    @id @map("lot_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  auctionId     String    @map("auction_id") @db.Uuid
  currency      String    @db.Char(3)
  startingPrice Decimal   @map("starting_price") @db.Decimal(12, 2)
  minIncrement  Decimal   @map("min_increment") @db.Decimal(12, 2)
  closesAt      DateTime  @map("closes_at") @db.Timestamptz(3)
  status        LotStatus
  currentPrice  Decimal?  @map("current_price") @db.Decimal(12, 2)
  currentBidder String?   @map("current_bidder") @db.Uuid
  winnerId      String?   @map("winner_id") @db.Uuid

  @@index([tenantId])
  @@map("lot_decision")
}

/// Un mismo evento lo registra cada consumidor una vez: clave primaria compuesta (corrige la spec §6).
model ProcessedEvent {
  eventId   String   @map("event_id") @db.Uuid
  consumer  String
  handledAt DateTime @default(now()) @map("handled_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_event")
}

model OutboxMessage {
  id          String    @id @db.Uuid
  topic       String
  key         String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_message")
}

/// Bitácora append-only de los eventos de dominio (D6). Los disparadores que rechazan
/// UPDATE/DELETE/TRUNCATE viven en la migración 0003 (Prisma no los expresa).
model AuditLog {
  eventId         String   @id @map("event_id") @db.Uuid
  type            String
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Clave de partición del evento (`lotId` o `auctionId`).
  key             String
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(3)
  /// El evento completo, sin tocar.
  payload         Json
  /// De dónde se leyó: permite trazar la fila hasta su posición exacta en el log.
  sourceTopic     String   @map("source_topic")
  sourcePartition Int      @map("source_partition")
  sourceOffset    BigInt   @map("source_offset")
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@index([tenantId, occurredAt])
  @@index([key, occurredAt])
  @@map("audit_log")
}
