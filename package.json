{
  "name": "bidstream",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsc -b",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:api": "npm run dev -w @bidstream/api",
    "dev:relay": "npm run dev -w @bidstream/relay",
    "dev:projector": "npm run dev -w @bidstream/projector",
    "dev:auditor": "npm run dev -w @bidstream/auditor",
    "dev:notifier": "npm run dev -w @bidstream/notifier-app",
    "dev:graphql": "npm run dev -w @bidstream/graphql",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:high": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
